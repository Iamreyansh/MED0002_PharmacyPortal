{
  "name": "med0002-pharmacy-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:federation": "playwright test -c playwright.federation.config.ts",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build",
    "smoke:prod": "bash scripts/post-deploy-smoke.sh",
    "tf:fmt": "terraform fmt -recursive infra",
    "tf:validate:staging": "terraform -chdir=infra/environments/staging init -backend=false && terraform -chdir=infra/environments/staging validate",
    "tf:validate:production": "terraform -chdir=infra/environments/production init -backend=false && terraform -chdir=infra/environments/production validate",
    "tf:plan:staging": "terraform -chdir=infra/environments/staging plan -input=false -out=tfplan && bash scripts/tf-plan-guard.sh infra/environments/staging/tfplan",
    "tf:plan:production": "terraform -chdir=infra/environments/production plan -input=false -out=tfplan && bash scripts/tf-plan-guard.sh infra/environments/production/tfplan",
    "tf:apply:staging": "terraform -chdir=infra/environments/staging apply -input=false tfplan",
    "tf:apply:production": "terraform -chdir=infra/environments/production apply -input=false tfplan",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@medmate/auth-contract": "file:../MED0003_MFE/packages/auth-contract",
    "@medmate/onboarding-contract": "file:../MED0003_MFE/packages/onboarding-contract",
    "@medmate/settings-contract": "file:../MED0003_MFE/packages/settings-contract",
    "@medmate/subscription-contract": "file:../MED0003_MFE/packages/subscription-contract",
    "@medmate/catalogue-contract": "file:../MED0003_MFE/packages/catalogue-contract",
    "@medmate/inventory-contract": "file:../MED0003_MFE/packages/inventory-contract",
    "@medmate/procurement-contract": "file:../MED0003_MFE/packages/procurement-contract",
    "@medmate/pos-contract": "file:../MED0003_MFE/packages/pos-contract",
    "@medmate/billing-contract": "file:../MED0003_MFE/packages/billing-contract",
    "@medmate/rx-contract": "file:../MED0003_MFE/packages/rx-contract",
    "@medmate/orders-contract": "file:../MED0003_MFE/packages/orders-contract",
    "@medmate/finance-contract": "file:../MED0003_MFE/packages/finance-contract",
    "@medmate/analytics-contract": "file:../MED0003_MFE/packages/analytics-contract",
    "@medmate/contracts": "file:../MED0003_MFE/packages/contracts",
    "@medmate/federation-config": "file:../MED0003_MFE/packages/federation-config",
    "@medmate/host-kit": "file:../MED0003_MFE/packages/host-kit",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.30.1",
    "@medmate/vite-config": "file:../MED0003_MFE/packages/tooling/vite-config",
    "@module-federation/vite": "^1.7.1",
    "@playwright/test": "^1.53.2",
    "@reduxjs/toolkit": "^2.8.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "react-redux": "^9.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@medmate/federation-config": "file:../MED0003_MFE/packages/federation-config",
      "@module-federation/vite": "^1.7.1",
      "@tailwindcss/vite": "^4.1.12",
      "@vitejs/plugin-react": "^4.6.0",
      "tailwindcss": "^4.1.12",
      "vite": "^6.3.5"
    }
  }
}
