# Vite proxy target for /api (local `pnpm dev`). Core CORS does not include
# localhost, so leave VITE_API_BASE_URL unset and let the browser call
# same-origin /api/v1.
VITE_API_PROXY_TARGET=http://localhost:8080

# Leave unset in staging/production. Deploy writes apiBaseUrl in
# /runtime-config.json (staging: https://core.api.staging.nammamedmate.com,
# production: https://core.api.nammamedmate.com). Set only for a local
# cross-origin override against an API that allows this origin.
# VITE_API_BASE_URL=https://core.api.staging.nammamedmate.com

# Local Module Federation remotes are served from the sibling MED0003 build.
VITE_MFE_DIST_ROOT=/Volumes/SSD/codebase/medmate/MED0003_MFE/dist

# Demo remotes (off by default). Never enables Core write APIs.
# When true, /todos mounts the Todo remote from /__mfe/todo when dist exists.
# VITE_ENABLE_DEMO_REMOTES=true

# Optional override; default in local dev is same-origin /__mfe/<name>/mf-manifest.json
# when that folder exists under VITE_MFE_DIST_ROOT.
# Deployed builds set one suffix; getRemoteUrl builds
# https://<name>.<suffix>/mf-manifest.json for every remote.
# VITE_MFE_DOMAIN_SUFFIX=mfe.nammamedmate.com
# Staging: VITE_MFE_DOMAIN_SUFFIX=staging.mfe.nammamedmate.com
# Optional per-remote override (tests, local ports):
# VITE_REMOTE_TODO_URL=http://localhost:5173/__mfe/todo/mf-manifest.json

# Playwright sets this so federation auto-init cannot block host bootstrap.
# VITE_DISABLE_LOCAL_MFE_DIST=true
