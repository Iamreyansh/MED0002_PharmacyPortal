# Demo remotes (off by default). Never enables Core write APIs.
# VITE_ENABLE_DEMO_REMOTES=true

# Vite proxy target for /api (local `pnpm dev`). Core has no CORS, so leave
# VITE_API_BASE_URL unset and let the browser call same-origin /api/v1.
VITE_API_PROXY_TARGET=http://localhost:8080

# Set only when the SPA and API share CORS (staging/production builds).
# VITE_API_BASE_URL=https://api.example.com

# Demo-only Todo MFE. Not part of pharmacy product navigation.
# VITE_REMOTE_TODO_URL=http://localhost:5101/mf-manifest.json
